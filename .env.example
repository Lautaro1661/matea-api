# ---------------------------------------------------------------
# Variables de entorno de MateA API (valores de EJEMPLO)
# Para usar MongoDB Atlas reemplazá MONGODB_URI por tu cadena de conexión,
# con un usuario DESCARTABLE y permisos mínimos (nunca credenciales reales).
# ---------------------------------------------------------------
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/matea
# Ejemplo Atlas: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/matea?retryWrites=true&w=majority
JWT_SECRET=cambiar_este_secreto_por_uno_largo_y_aleatorio_de_ejemplo
JWT_EXPIRES_IN=1d
